ARG BASE_VERSION=15.1
ARG BUILD_BASE_VERSION=15.1-latest
ARG UPSTREAM_URL="https://api.github.com/repos/rustmailer/bichon/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

# --- Source Stage ---
# One tag for frontend and backend, from the same releases/latest the version
# check reads. "Highest git tag" would pick pre-releases (2.0.1-alpha.1 sorts
# after 2.0.1).
FROM ghcr.io/daemonless/base:${BUILD_BASE_VERSION} AS source

ARG UPSTREAM_URL
ARG UPSTREAM_JQ

RUN pkg update && \
    pkg install -y git-lite

RUN BICHON_TAG=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}") && \
    test -n "${BICHON_TAG}" -a "${BICHON_TAG}" != "null" && \
    echo "Building tag: ${BICHON_TAG}" && \
    git clone --depth 1 -b "${BICHON_TAG}" https://github.com/rustmailer/bichon.git /src && \
    echo "${BICHON_TAG}" > /src/version

# --- Frontend Builder Stage ---
FROM ghcr.io/daemonless/base:${BUILD_BASE_VERSION} AS frontend

ARG PNPM_VERSION=9

RUN pkg update && \
    pkg install -y node24 npm-node24 && \
    npm install -g "pnpm@${PNPM_VERSION}"

COPY --from=source /src/web /build/web
WORKDIR /build/web

# @vitejs/plugin-react-swc needs SWC, which has no FreeBSD binary. Upstream
# calls react() with no options, so the Babel plugin is a drop-in; the grep
# fails the build if upstream's import changes and the sed stops matching.
# Adding it only appends to the lockfile (no locked version moves).
# NODE_OPTIONS: arm64 FreeBSD caps RLIMIT_DATA at 1 GB and Node sizes its
# default heap from it.
RUN pnpm install --frozen-lockfile && \
    pnpm add -D @vitejs/plugin-react@4.7.0 && \
    sed -i '' "s#'@vitejs/plugin-react-swc'#'@vitejs/plugin-react'#" vite.config.ts && \
    grep -q "from '@vitejs/plugin-react'" vite.config.ts && \
    NODE_OPTIONS=--max-old-space-size=4096 pnpm run build

# --- Backend Builder Stage ---
# Use 15-latest for rust 1.95+ required by bichon 1.0.0 (sysinfo@0.39.1)
FROM ghcr.io/daemonless/base:${BUILD_BASE_VERSION} AS builder

ARG FREEBSD_ARCH=amd64
ARG BUILD_PACKAGES="rust pkgconf git-lite FreeBSD-toolchain FreeBSD-openssl-dev zstd FreeBSD-set-devel cmake"

# Install build dependencies
RUN pkg update && \
    pkg install -y ${BUILD_PACKAGES}

COPY --from=source /src /build
WORKDIR /build

# web/dist is embedded into the Rust binary at compile time.
COPY --from=frontend /build/web/dist /build/web/dist

# Build Backend
RUN cargo build --release --bin bichon-server --bin bichon-cli --bin bichon-admin

# --- Runtime Stage ---
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG UPSTREAM_URL
ARG UPSTREAM_JQ
ARG PACKAGES="FreeBSD-openssl zstd curl"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="https://github.com/daemonless/bichon" \
      org.opencontainers.image.url="https://github.com/rustmailer/bichon" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}"

# Install runtime dependencies
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Copy binaries and version from builder
COPY --from=builder /build/version /app/version
COPY --from=builder /build/target/release/bichon-server /usr/local/bin/
COPY --from=builder /build/target/release/bichon-cli /usr/local/bin/
COPY --from=builder /build/target/release/bichon-admin /usr/local/bin/

# Copy root filesystem
COPY root/ /

# Set permissions
RUN chmod +x /etc/services.d/bichon/run /healthz && \
    mkdir -p /data

# Working directory for Bichon
WORKDIR /data
VOLUME /data

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='port') | join(' ') }}
{%- endif %}
